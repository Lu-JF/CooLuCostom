{
  "name": "cortico-world-quota",
  "version": "0.2.0",
  "type": "module",
  "description": "Cortico World: Command Code plan quota (monthly credits, rolling 5-hour and weekly windows) plus multi-account switching, the plan's model list with unit prices and per-model allowances, vendor switch seams, and local Hermes token usage, as a console panel with progress bars and as spoken alerts through the desktop pet",
  "license": "MIT",
  "keywords": [
    "cortico-world",
    "cortico",
    "quota",
    "command-code",
    "hermes"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./src/index.ts",
  "cortico": {
    "kind": "world",
    "api": 6,
    "displayName": "用量额度",
    "webUiClient": "dist/webui.js",
    "webUiStyle": "dist/webui.css",
    "describe": "describe.json"
  },
  "files": [
    "src",
    "dist",
    "README.md",
    "describe.json"
  ],
  "scripts": {
    "build": "node scripts/build-webui.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.web.json",
    "link:instance": "node scripts/link-into-instance.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "cortico": "^0.2.7",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true
  }
}
